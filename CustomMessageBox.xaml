<Window x:Class="WorkTimeWPF.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="消息" Height="197" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- 按钮样式 -->
        <Style x:Key="MessageBoxButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F0F0"/>
                                <Setter Property="BorderBrush" Value="#999999"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#E0E0E0"/>
                                <Setter Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                            <Trigger Property="IsDefault" Value="True">
                                <Setter Property="Background" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderBrush" Value="#0078D4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,20,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="60"/>
            <RowDefinition Height="Auto" MinHeight="32"/>
        </Grid.RowDefinitions>

        <!-- 消息内容区域 -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 图标 -->
            <TextBlock x:Name="MessageIcon" Grid.Column="0" Text="ℹ️" FontSize="32" 
                       Margin="0,0,15,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

            <!-- 消息文本 -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="MessageText" FontSize="13" 
                           Foreground="Black" TextWrapping="Wrap"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Text="这是一条测试消息"
                           Visibility="Visible"/>
            </ScrollViewer>
        </Grid>

        <!-- 按钮区域 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,0,0,0">
            <Button x:Name="OkButton" Style="{StaticResource MessageBoxButtonStyle}" 
                    Click="OkButton_Click" IsDefault="True" Margin="0" Height="19">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="确定" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="CancelButton" Style="{StaticResource MessageBoxButtonStyle}" 
                    Click="CancelButton_Click" IsCancel="True" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✕" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="取消" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="YesButton" Style="{StaticResource MessageBoxButtonStyle}" 
                    Click="YesButton_Click" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="是" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="NoButton" Style="{StaticResource MessageBoxButtonStyle}" 
                    Click="NoButton_Click" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✕" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="否" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>